# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                         CONFIGURARE PROIECT                                ║
# ╠════════════════════════════════════════════════════════════════════════════╣
# ║  CUM SE FOLOSESTE:                                                         ║
# ║  1. Copiaza acest fisier: cp .env.example .env                             ║
# ║  2. Modifica valorile in .env (nu in .env.example!)                        ║
# ║  3. Reporneste serverul: pnpm dev                                          ║
# ║                                                                            ║
# ║  NOTA: Modificarile in .env necesita restart server pentru a avea efect    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ========================================
# Database (OBLIGATORIU)
# ========================================
# Database connection string (MongoDB local via Docker)
DATABASE_URI=mongodb://127.0.0.1/universal-business

# ========================================
# Security (OBLIGATORIU)
# ========================================
# Used to encrypt JWT tokens - schimba cu un string unic!
# Genereaza unul: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ========================================
# Cloud Storage (OPTIONAL)
# ========================================
# Cloudflare R2 Storage (S3-compatible)
# Fara aceste variabile, Payload foloseste storage local (./media)
# Cu R2 configurat, imaginile SI VIDEO-urile sunt stocate in cloud
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont Cloudflare: https://dash.cloudflare.com/
# 2. Mergi la R2 -> Create Bucket
# 3. Seteaza bucket-ul ca PUBLIC (Settings -> Public Access -> Allow)
# 4. Creeaza API Token: R2 -> Manage R2 API Tokens (selecteaza Object Read & Write)
# 5. (Optional) Configureaza custom domain pentru CDN mai rapid
# 6. Decomenteaza si completeaza variabilele de mai jos:
#
# R2_BUCKET=numele-bucket-ului
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
#
# (Optional) Custom domain pentru R2 - pentru URL-uri mai scurte si CDN
# Configureaza in Cloudflare R2 -> Bucket -> Settings -> Custom Domain
# R2_PUBLIC_URL=https://media.domeniul-tau.ro

# ========================================
# Email (OPTIONAL)
# ========================================
# Resend - pentru notificari formulare
# Fara aceste variabile, formularele salveaza datele dar NU trimit email
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont: https://resend.com
# 2. Obtine API key: https://resend.com/api-keys
# 3. Verifica domeniul in Resend (pentru a trimite de pe domeniul tau)
# 4. Completeaza variabilele de mai jos:
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=contact@domeniul-tau.ro
RESEND_FROM_NAME=Numele Afacerii

# ========================================
# E-commerce (OPTIONAL)
# ========================================
# Sistem complet de magazin online cu cos si comenzi
#
# CUM SE ACTIVEAZA:
# 1. Schimba ENABLE_ECOMMERCE=true
# 2. Ruleaza: pnpm seed:magazin -- --with-images
# 3. Reporneste serverul
#
# CE INCLUDE:
# - Colectii: products, carts, orders
# - Pagini: /produse, /cos, /checkout
# - Functioneaza SI FARA Stripe (comenzi prin email)
#
ENABLE_ECOMMERCE=false

# ========================================
# Stripe - Plati Online (OPTIONAL)
# ========================================
# Doar daca vrei plata cu card. Fara Stripe, comenzile se trimit pe email.
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont: https://dashboard.stripe.com
# 2. Obtine chei: https://dashboard.stripe.com/apikeys
# 3. Configureaza webhook pentru /api/stripe/webhook
# 4. Completeaza variabilele de mai jos:
#
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================================
# Fonts - Tipografie (OPTIONAL)
# ========================================
# Configureaza fonturile pentru heading si body text
# NOTA: Se incarca doar 2 fonturi pentru performanta maxima!
#
# Optiuni disponibile:
#   Inter, Playfair_Display, Montserrat, Open_Sans, Poppins,
#   Lato, Lora, Source_Sans_3, Work_Sans
#
# Recomandari combinatii:
#   Elegant: Playfair_Display + Inter (serif + sans-serif)
#   Modern: Montserrat + Open_Sans (sans + sans)
#   Profesional: Work_Sans + Source_Sans_3 (sans + sans)
#
# IMPORTANT: Necesita restart server dupa modificare!
#
NEXT_PUBLIC_HEADING_FONT=Playfair_Display
NEXT_PUBLIC_BODY_FONT=Inter
