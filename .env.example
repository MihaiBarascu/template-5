# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    MULTI-TENANT PLATFORM CONFIG                            ║
# ╠════════════════════════════════════════════════════════════════════════════╣
# ║  CUM SE FOLOSESTE:                                                         ║
# ║  1. Copiaza acest fisier: cp .env.example .env                             ║
# ║  2. Modifica valorile in .env (nu in .env.example!)                        ║
# ║  3. Creeaza super admin: pnpm seed:super-admin                             ║
# ║  4. Porneste serverul: pnpm dev                                            ║
# ║                                                                            ║
# ║  NOTA: Modificarile in .env necesita restart server pentru a avea efect    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ========================================
# Database (OBLIGATORIU)
# ========================================
DATABASE_URI=mongodb://127.0.0.1/universal-business

# ========================================
# Security (OBLIGATORIU)
# ========================================
# Used to encrypt JWT tokens - schimba cu un string unic!
# Genereaza unul: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs and API calls
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ========================================
# Super Admin (OPTIONAL)
# ========================================
# Credentiale pentru super admin-ul platformei
# Ruleaza: pnpm seed:super-admin
#
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=admin123
# SUPER_ADMIN_NAME=Super Administrator

# ========================================
# Cloud Storage (OPTIONAL)
# ========================================
# Cloudflare R2 Storage (S3-compatible) - SHARED pentru toti tenants
# Fara aceste variabile, Payload foloseste storage local (./media)
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont Cloudflare: https://dash.cloudflare.com/
# 2. Mergi la R2 -> Create Bucket
# 3. Seteaza bucket-ul ca PUBLIC (Settings -> Public Access -> Allow)
# 4. Creeaza API Token: R2 -> Manage R2 API Tokens
# 5. (Optional) Configureaza custom domain pentru CDN
#
# R2_BUCKET=numele-bucket-ului
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://media.domeniul-tau.ro

# ========================================
# Email (OPTIONAL)
# ========================================
# Resend - pentru notificari email (formulare, comenzi, bookings)
# SHARED pentru toti tenants - emailurile se trimit catre business info per tenant
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont: https://resend.com
# 2. Obtine API key: https://resend.com/api-keys
# 3. Verifica domeniul in Resend
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@platforma-ta.ro

# ========================================
# Stripe - Plati Online (OPTIONAL)
# ========================================
# Pentru plati cu card. Fara Stripe, comenzile se trimit pe email.
#
# CUM SE ACTIVEAZA:
# 1. Creeaza cont: https://dashboard.stripe.com
# 2. Obtine chei: https://dashboard.stripe.com/apikeys
# 3. Configureaza webhook pentru /api/stripe/webhook
#
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ========================================
# HTTP Basic Auth - Protectie Site (OPTIONAL)
# ========================================
# Protejeaza site-ul cu user/parola in staging/development
#
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=parola-secreta

# ========================================
# Multi-Tenant Notes
# ========================================
# Urmatoarele setari sunt acum PER TENANT (in Payload Admin):
#
# - Business Info: nume, email, telefon, adresa (Global: business-info)
# - Site Theme: culori, fonturi, dark mode (Global: site-theme)
# - E-commerce: activare shop, setari (Global: shop-settings)
# - Header/Footer: navigare, logo, social links (Globals)
#
# Pentru a crea un nou tenant:
# 1. Logheaza-te ca super-admin
# 2. Mergi la Tenants -> Create
# 3. Introdu numele (slug-ul se genereaza automat)
# 4. Foloseste API: POST /api/seed-tenant pentru a popula cu date
